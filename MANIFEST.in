recursive-include tools *.py
recursive-include docs *.md *.json
include CHANGELOG.md ECOSYSTEM_GUIDE.md MIGRATION.md
include setup.py
include native/_core.cpp
include native/_planning_native_core.cpp
include native/_planning_runtime_inspector.cpp
include native/runtime_inspector_profile.json
recursive-include native/include *.hpp

# Internal working material (plans, probes, notes with workstation paths or
# customer-project names) stays out of the sdist; the wheel never had it.
# Guarded by tests/test_sdist_no_internal_content_20261124.py.
exclude docs/CH3E_DELIVERY.md
exclude docs/CYLINDER_ATLAS_CONTRACT.md
